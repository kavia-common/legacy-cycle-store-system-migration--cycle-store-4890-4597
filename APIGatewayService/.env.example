# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGINS=*

# Auth / JWT
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Backend services
BUSINESS_LOGIC_URL=http://localhost:4000
DATA_SERVICE_URL=http://localhost:3001/api/v1
NOTIFICATION_SERVICE_URL=http://localhost:5000/api/v1

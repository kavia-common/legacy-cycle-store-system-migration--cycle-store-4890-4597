# API Gateway environment variables
PORT=3000
HOST=0.0.0.0

# Downstream service URLs (ensure they are reachable from the gateway)
BL_SERVICE_URL=http://localhost:4001
DATA_SERVICE_URL=http://localhost:4002
NOTIFY_SERVICE_URL=http://localhost:4003

# JWT / Auth settings (for production, use secure secrets / JWKS)
JWT_ISSUER=https://auth.cyclestore.com/
JWT_AUDIENCE=api-gateway
JWT_JWKS_URI=https://auth.cyclestore.com/.well-known/jwks.json

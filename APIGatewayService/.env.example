# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Upstream services
BL_SERVICE_URL=http://localhost:4001
DATA_SERVICE_URL=http://localhost:4002
NOTIFY_SERVICE_URL=http://localhost:4003
MONITOR_SERVICE_URL=http://localhost:4601

# Security
JWT_PUBLIC_KEY_BASE64= # base64-encoded PEM public key for verifying JWT (if using RS256)
JWT_SECRET= # optional if using HS256
JWT_ALG=RS256 # RS256 or HS256
OAUTH2_ISSUER=https://auth.cyclestore.com
OAUTH2_AUDIENCE=api.cyclestore.com
REQUIRED_SCOPES= # comma separated oauth scopes

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Compliance & audit
AUDIT_ENABLED=true
LOG_LEVEL=info

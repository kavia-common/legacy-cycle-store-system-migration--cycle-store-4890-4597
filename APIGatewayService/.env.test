# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=localhost

# JWT Configuration for tests
JWT_ALG=HS256
JWT_SECRET=test-secret-key-for-testing-purposes-only
JWT_EXPIRES_IN=3600

# Disable rate limiting in tests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_PUBLIC_MAX=1000

# Disable external dependencies in tests
HEALTH_CHECK_DEPENDENCIES=false
CIRCUIT_BREAKER_ENABLED=false
AUDIT_ENABLED=false

# Test service URLs (will fail but that's expected in tests)
BL_SERVICE_URL=http://localhost:4001
DATA_SERVICE_URL=http://localhost:4002
NOTIFY_SERVICE_URL=http://localhost:4003
MONITOR_SERVICE_URL=http://localhost:4601

# Logging configuration for tests
LOG_LEVEL=error
LOG_JSON=false

# Security settings for tests
SECURITY_HEADERS_ENABLED=true
CORS_ORIGINS=*
TRUSTED_PROXIES=

# Development features
DEV_MODE=true
DEV_LOG_REQUESTS=false
DEV_DETAILED_ERRORS=true
